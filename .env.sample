# dev-vis 環境変数設定
# このファイルを .env にリネームして使用してください
# cp .env.sample .env

# ===================
# アプリケーション設定
# ===================

# データディレクトリパス
# リポジトリごとに data/<owner>__<repo>/repo.duckdb が自動作成されます
DATA_DIR=./data

# アプリケーションポート
PORT=3000

# ===================
# GitHub 設定
# ===================

# GitHub Personal Access Token
# リポジトリ一覧取得・データ収集に必要
#
# Fine-grained PAT の場合、以下の権限が必要:
#   - Contents: Read (リポジトリデータ取得)
#   - Pull requests: Read (PR 一覧取得)
#   - Checks: Read (CI 結果取得 - Change Failure Rate に必要)
#   - Commit statuses: Read (CI 結果取得 - Change Failure Rate に必要)
#
# Classic PAT の場合: repo スコープ
# GITHUB_TOKEN=

# ===================
# トークン管理設定
# ===================

# 画面からのトークン操作を許可するか (デフォルト: true)
# "false" に設定すると Settings ページからのトークン追加・削除を禁止
ALLOW_TOKEN_UI=true

# トークン暗号化キー (64文字の16進数 = 32バイト)
# 未設定の場合、初回起動時に data/.encryption_key に自動生成
# ENCRYPTION_KEY=
