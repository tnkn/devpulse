# dev-vis 環境変数設定
# このファイルを .env にリネームして使用してください
# cp .env.sample .env

# ===================
# アプリケーション設定
# ===================

# データディレクトリパス
DATA_DIR=./data

# アプリケーションポート
PORT=3000

# ===================
# GitHub 設定（将来用）
# ===================

# GitHub Personal Access Token（プライベートリポジトリ用）
# GITHUB_TOKEN=
