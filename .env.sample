# devpulse 環境変数設定
# このファイルを .env にリネームして使用してください
# cp .env.sample .env

# ===================
# アプリケーション設定
# ===================

# データディレクトリパス
# リポジトリごとに data/<owner>__<repo>/repo.duckdb が自動作成されます
DATA_DIR=./data

# アプリケーションポート
PORT=3000

# ===================
# GitHub 設定
# ===================

# GitHub Personal Access Token
#
# 必須ではありません。トークンは Settings ページからも登録でき、
# 登録済みのデフォルトトークンがあればそちらが優先されます。
# ここに設定した値は、DB にトークンが無いときのフォールバックです。
#
# Fine-grained PAT の場合、対象リポジトリに以下の権限が必要:
#   - Metadata: Read          (リポジトリ検索・一覧の取得)
#   - Contents: Read          (コミット履歴の取得)
#   - Issues: Read            (Issue・依存関係・サブイシューの取得)
#                             依存関係グラフから追加・削除する場合は Read and write
#   - Projects: Read          (Projects v2 の Priority / Size の取得。組織レベルの権限。
#                             無くても収集は成功し、この 2 項目だけ空になります)
#                             テーブルから変更する場合は Read and write
#   - Pull requests: Read     (PR 一覧・詳細・レビュー履歴の取得)
#   - Checks: Read            (CI 結果の取得 - Change Failure Rate に必須)
#   - Commit statuses: Read   (CI 結果の取得 - Checks と併用推奨)
#
# Classic PAT の場合: repo スコープ
#   Projects v2 の Priority / Size も取得する場合は read:project も追加
#
# 詳細は README.md の「GitHub Personal Access Token の設定」を参照
# GITHUB_TOKEN=

# GitHub API のベース URL
# GitHub Enterprise Server を使う場合のみ設定します。
# REST と GraphQL (<このURL>/graphql) の両方がこの値から組み立てられます。
# GITHUB_API_URL=https://api.github.com

# ===================
# トークン管理設定
# ===================

# 画面からのトークン操作を許可するか (デフォルト: true)
# "false" に設定すると Settings ページからのトークン追加・削除を禁止
ALLOW_TOKEN_UI=true

# トークン暗号化キー (64文字の16進数 = 32バイト)
# 設定した場合はこちらが優先されます。
# 未設定の場合、初回起動時に data/.encryption_key に自動生成
# ENCRYPTION_KEY=
